# Sao chép thành .env (đã gitignore). Spring đọc file này qua spring.config.import trong application.yaml,
# docker compose cũng đọc để tạo Postgres cùng user/password.
DB_URL=jdbc:postgresql://localhost:5432/event-application-db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Ký và verify JWT (HS256), tối thiểu 32 ký tự. Sinh: openssl rand -hex 32
JWT_SECRET=

# Đăng nhập Google. Tạo OAuth Client ID loại "Web application" ở Google Cloud Console:
#   Authorized JavaScript origins: http://localhost:3000 (FE) và http://localhost:8080 (BE)
# Bỏ trống GOOGLE_CLIENT_ID = tắt nút đăng nhập Google (app vẫn chạy bình thường).
GOOGLE_CLIENT_ID=
# Không dùng ở luồng hiện tại (BE chỉ verify id_token). Giữ lại nếu sau này đổi sang luồng redirect.
GOOGLE_CLIENT_SECRET=

# PayOS — cổng thanh toán duy nhất. BẮT BUỘC có, thiếu là app không khởi động (xem README mục "Cổng thanh toán PayOS").
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL public nhận webhook (cloudflared/ngrok), app gọi confirm-webhook 1 lần lúc khởi động.
# Bỏ trống = không đăng ký, PayOS sẽ không gọi về (phải khai tay trên dashboard).
PAYOS_WEBHOOK_URL=

# Kênh chi hộ PayOS (payout), chỉ cần khi làm refund. Cùng tài khoản với kênh thu ở trên.
# Cần bật kênh chi hộ + liên kết ví Bao Kim + whitelist IP server + nạp tiền ví mới chi được.
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# Upload ảnh lên Cloudinary (tùy chọn). Bỏ trống hết thì lưu ở thư mục uploads/ và phục vụ qua GET /uploads/**
# Cách 1: dán nguyên chuỗi Dashboard cho sẵn (mục "API environment variable")
CLOUDINARY_URL=
# Cách 2: điền rời đúng 3 ô ở Settings -> API Keys (chỉ dùng khi CLOUDINARY_URL để trống).
# Thiếu một trong ba thì coi như chưa cấu hình, ảnh vẫn lưu ở đĩa.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phí dịch vụ mỗi đơn (VND). Bỏ trống = 0, khách trả đúng tiền vé.
# Chỉ đặt khác 0 khi thật sự có tài khoản nhận phí tách khỏi tài khoản BTC.
# CHECKOUT_FEE=0
